@model List<ToDoList>

<div class="col-md-6">
    <div class="h-100 bg-white rounded p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            
            <h4 class="card-title">Yapılacaklar Listesi</h4>
            
        </div>
        
        @foreach (var item in Model)
        {
                <div class="d-flex align-items-center border-bottom py-2">
                    <input class="form-check-input m-0" type="checkbox">
                    <div class="w-100 ms-3">
                        <div class="d-flex w-100 align-items-center justify-content-between">
                        <span>@item.Title</span>
                        @if (item.Status == true)
                        {

                            <button href="/ToDoList/ChangeToDoListStatusFalse/@item.ToDoListId" class="btn btn-dark">Yapılmadı Olarak İşaretle</button>
                        }
                        else
                        {

                            <button href="/ToDoList/ChangeToDoListStatusTrue/@item.ToDoListId" class="btn btn-info">Yapıldı Olarak İşaretle</button>
                        }
                        </div>
                    </div>
                </div>
           

        }



    </div>
</div>