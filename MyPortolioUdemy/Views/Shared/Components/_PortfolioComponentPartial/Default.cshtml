@model List<MyPortolioUdemy.DAL.Entities.Portfolio>
<section id="works" class="s-works target-section">

    <div class="row narrow section-intro has-bottom-sep">
        <div class="col-full">
            <h3>Portfolyo</h3>
            <h1>Son Projelerime Göz Atabilirsiniz.</h1>

           
        </div>
    </div>

    <div class="row masonry-wrap">
        <div class="masonry">
            @foreach (var item in Model)
            {
                <div class="masonry__brick">
                    <div class="item-folio">

                        <div class="item-folio__thumb">
                            <a href="~/hola-master/images/portfolio/RealEstate.jpg" class="thumb-link" title="@item.Title" data-size="1050x700">
                                <img src="~/hola-master/images/portfolio/RealEstate.jpg"
                                     srcset="/hola-master/images/portfolio/RealEstate.jpg 1x, /hola-master/images/portfolio/RealEstate1.jpg 2x" alt="">
                                <span class="shadow-overlay"></span>
                            </a>
                        </div>

                        <div class="item-folio__text">
                            <h3 class="item-folio__title">
                                @item.Title
                            </h3>
                            <p class="item-folio__cat">
                                @item.SubTitle
                            </p>
                        </div>

                        <div class="item-folio__caption">
                            <p>@item.Description</p>
                            <a href="@item.Url" class="btn btn-info" role="button">Projeye Göz At</a>

                        </div>

                    </div> <!-- end item-folio -->
                </div>
            }
            <!-- end masonry__brick -->


        </div>
    </div> <!-- end masonry -->

</section>
